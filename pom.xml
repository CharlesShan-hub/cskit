<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>top.cskit</groupId>
    <artifactId>cskit</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>cskit</name>
    <description>CSKit Java 工具库：统一 JSON 门面 + 可插拔适配器（依赖隔离）</description>

    <modules>
        <module>json-core</module>
        <module>json-gson</module>
        <module>json-fastjson</module>
        <module>json-jackson</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <gson.version>2.10</gson.version>
        <fastjson2.version>2.0.53</fastjson2.version>
        <jackson.version>2.17.0</jackson.version>
        <junit.version>5.10.3</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>top.cskit</groupId>
                <artifactId>json-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cskit</groupId>
                <artifactId>json-gson</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cskit</groupId>
                <artifactId>json-fastjson</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>top.cskit</groupId>
                <artifactId>json-jackson</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
